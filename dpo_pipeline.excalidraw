    {
      "type": "text",
      "id": "loss_formula",
      "x": 590,
      "y": 330,
      "width": 140,
      "height": 110,
      "text": "L = -log σ(β · (log πθ/πref_c\n    - log πθ/πref_r))\n\nβ: temperature\nσ: sigmoid\n_c: chosen, _r: rejected",
      "originalText": "L = -log σ(β · (log πθ/πref_c\n    - log πθ/πref_r))\n\nβ: temperature\nσ: sigmoid\n_c: chosen, _r: rejected",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
