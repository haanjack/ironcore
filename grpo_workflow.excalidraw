      "x": 70,
      "y": 547,
      "width": 660,
      "height": 40,
      "text": "# grpo.py - Group-relative advantage\nA_i = (R_i - mean(R_g)) / (std(R_g) + ε)  # Key insight!\nrewards = worker_pool.score_batch(prompts, responses) # Parallel",
      "originalText": "# grpo.py - Group-relative advantage normalization (key insight!)\nA_i = (R_i - mean(R_group)) / (std(R_group) + ε)   # Normalize within each prompt's G completions\nrewards = worker_pool.score_batch(prompts, responses, metadata)        # Parallel computation",
      "fontSize": 11,
      "fontFamily": 3,
