    {
      "type": "text",
      "id": "text_evidence_gen",
      "x": 70,
      "y": 377,
      "width": 660,
      "height": 50,
      "text": "# rollout.py - Prefix KV-cache sharing\nlogits, kv = model(prompt_ids, use_cache=True)  # Prefill once\nkv = _expand_kv_cache(kv, G)                     # [B] → [B×G]\nfor t: logits, kv = model(tok, past_kv=kv)      # Decode B×G parallel",
      "originalText": "# rollout.py - Prefix KV-cache sharing\nlogits, kv = model(prompt_ids, use_cache=True)     # Prefill once\nexpanded_kv = _expand_kv_cache(kv, G)              # [B] → [B×G]\nfor t in range(T): logits, kv = model(prev_tok, past_kv=kv)  # Decode all B×G in parallel",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
