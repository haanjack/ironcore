    {
      "type": "text",
      "id": "text_evidence_loss",
      "x": 70,
      "y": 892,
      "width": 660,
      "height": 50,
      "text": "# grpo.py - GRPO loss\npolicy_loss = -(advantages * log_probs).mean()  # Policy gradient\nkl_loss = β * (log_probs - ref_log_probs).mean() # KL penalty\ntotal_loss = policy_loss + kl_loss               # Combined",
      "originalText": "# grpo.py - GRPO loss = policy gradient + KL penalty\npolicy_loss = -(advantages * policy_log_probs).mean()        # Gradient ascent on advantages\nkl_loss = beta * (policy_log_probs - ref_log_probs).mean()   # KL penalty to stay near π_ref\ntotal_loss = policy_loss + kl_loss                           # Combined objective",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
