      "y": 800,
      "width": 430,
      "height": 120,
      "text": "alignment:\n  reward_manager:\n    functions:\n      - name: correctness\n        type: math\n        weight: 0.8\n      - name: format\n        type: format\n        required_tags: [\"<think\", \"</think\", \"####\"]\n        weight: 0.2",
