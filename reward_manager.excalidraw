    {
      "type": "text",
      "id": "manager_code_text",
      "x": 110,
      "y": 290,
      "width": 360,
      "height": 80,
      "text": "manager = RewardManager()\nmanager.register(\"math\", MathRewardFunction(), 0.8)\nmanager.register(\"format\", FormatRewardFunction(), 0.2)\n# total = Σ weight_i * fn_i.compute(p, c, m)",
      "originalText": "manager = RewardManager()\nmanager.register(\"math\", MathRewardFunction(), 0.8)\nmanager.register(\"format\", FormatRewardFunction(), 0.2)\n# total = Σ weight_i * fn_i.compute(p, c, m)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 601301,
      "version": 1,
      "versionNonce": 601302,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "manager_methods",
      "x": 100,
      "y": 410,
      "width": 380,
      "height": 100,
      "text": "Methods:\n• register(name, fn, weight) - Add reward function\n• compute(p, c, m) → float - Weighted sum\n• from_config(cfg) - Build from YAML\n• from_legacy_config(cfg) - Backward compat",
      "originalText": "Methods:\n• register(name, fn, weight) - Add reward function\n• compute(p, c, m) → float - Weighted sum\n• from_config(cfg) - Build from YAML\n• from_legacy_config(cfg) - Backward compat",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
