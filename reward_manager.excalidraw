    {
      "type": "text",
      "id": "pattern_desc",
      "x": 575,
      "y": 800,
      "width": 370,
      "height": 120,
      "text": "Dense Reward for Small Models:\n  math (0.8) + format (0.2)\n  → Breaks zero-advantage death spiral\n\nReasoning Format:\n  strict_format (####\\s*-?\\d)\n  + keyword/tag checks\n\nScalable Evaluation:\n  API for small batches\n  Local endpoint for large scale",
      "originalText": "Dense Reward for Small Models:\n  math (0.8) + format (0.2)\n  → Breaks zero-advantage death spiral\n\nReasoning Format:\n  strict_format (####\\s*-?\\d)\n  + keyword/tag checks\n\nScalable Evaluation:\n  API for small batches\n  Local endpoint for large scale",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
