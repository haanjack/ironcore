    {
      "type": "text",
      "id": "pool_code_text",
      "x": 570,
      "y": 290,
      "width": 360,
      "height": 60,
      "text": "pool = RewardWorkerPool(reward_fn, num_workers=4)\nrewards = pool.score_batch(prompts, completions, metadata)\n# Returns: torch.Tensor([batch_size])",
      "originalText": "pool = RewardWorkerPool(reward_fn, num_workers=4)\nrewards = pool.score_batch(prompts, completions, metadata)\n# Returns: torch.Tensor([batch_size])",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 601801,
