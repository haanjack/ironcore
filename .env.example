# GitHub Access Token for Docker build (if needed for private packages)
# Leave empty if not required
github_access_token=

# Dataset base directory (defaults to current directory if not set)
DATASET_DIR=

# Preprocessed data path (defaults to ${DATASET_DIR}/preprocssed_corpus if not set)
PROCESSED_DATA_PATH=

# Other related environment variables
OMP_NUM_THREADS=1
HF_TOKEN=

# ============================================================
# AI Generation API Keys (for `ironcore generate` command)
# ============================================================

# Anthropic Claude (Native SDK)
# Get your key from: https://console.anthropic.com/
# Provider: --provider anthropic
# Models: claude-opus-4-20250514, claude-sonnet-4-20250514, claude-haiku-4-20250514
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Native SDK)
# Get your key from: https://platform.openai.com/api-keys
# Provider: --provider openai
# Models: gpt-4o, gpt-4o-mini, o1
OPENAI_API_KEY=your_openai_api_key_here

# Zhipu GLM (via OpenAI-compatible API)
# Get your key from: https://open.bigmodel.cn/usercenter/apikeys
# Provider: --provider glm (uses OPENAI_API_KEY)
# Base URL: https://api.z.ai/api/coding/paas/v4
# Models: glm-4.7, glm-4-air, glm-4-flash
GLM_API_KEY=your_glm_api_key_here

# Moonshot Kimi (via OpenAI-compatible API)
# Get your key from: https://platform.moonshot.cn/console/api-keys
# Provider: --provider kimi (uses OPENAI_API_KEY)
# Base URL: https://api.moonshot.cn/v1
# Models: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
KIMI_API_KEY=your_kimi_api_key_here

# ============================================================
# Local AI Servers (via OpenAI-compatible API)
# ============================================================

# Local vLLM Server
# Provider: --provider vllm
# Base URL: http://localhost:8000/v1
# API Key: dummy or not required
# Models: whatever model you're serving (e.g., llama-3-70b, qwen2-72b)

# Ollama
# Provider: --provider ollama
# Base URL: http://localhost:11434/v1
# API Key: dummy or not required
# Models: whatever model you're serving (e.g., llama3, qwen2)

# ============================================================
# Usage Examples
# ============================================================

# Using GLM:
#   export OPENAI_API_KEY="your_glm_api_key"
#   ironcore generate rmsnorm --provider glm

# Using Kimi:
#   export OPENAI_API_KEY="your_kimi_api_key"
#   ironcore generate rmsnorm --provider kimi --model moonshot-v1-32k

# Using local vLLM:
#   export OPENAI_API_KEY="dummy"
#   ironcore generate rmsnorm --provider vllm --model llama-3-70b

# Using OpenAI:
#   export OPENAI_API_KEY="your_openai_api_key"
#   ironcore generate rmsnorm --provider openai --model gpt-4o

# Using Anthropic Claude:
#   export ANTHROPIC_API_KEY="your_anthropic_api_key"
#   ironcore generate rmsnorm --provider anthropic --model claude-opus-4-20250514
